BEGIN:VEVENT
UID:habitat-gingerbread-build@advent-follow-along
DTSTAMP:20261120T040526Z
DTSTART;TZID=America/Denver:20261202T170000
DTEND;TZID=America/Denver:20261202T193000
SUMMARY:Habitat for Humanity Gingerbread House Build
LOCATION:Shepardson Hall East and West
DESCRIPTION:Gather a team of 5 to build the most creative and stable ginger
 bread house and win the Golden Gingerbread. $50 per team\, with all procee
 ds going to Habitat's Common Ground Faith Build. Teams must pre-register: 
 contact Chad Bauer\, Habitat's Faith Engagement Manager\, at cbauer@fortco
 llinshabitat.org.\n\nMore in the app: https://advent.firstpresfc.org/
URL:https://advent.firstpresfc.org/
END:VEVENT
